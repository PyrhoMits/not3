{
  "$schema": "https://opencode.ai",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cd ..*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cd /*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cd ~*",
      "effect": "deny"
    }
  ]
}
